SECRET_KEY=supersecretkeyforlocaldevelopment12345
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO

LLM_PROVIDER=hermes
HERMES_AGENT_PATH=/workspaces/NoorGroup/hermes-agent-main
