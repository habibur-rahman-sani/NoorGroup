# --- UI-TARS model endpoint (required) -------------------------------------
# Any OpenAI-Chat-Completions-compatible endpoint that serves a UI-TARS
# checkpoint. Pick ONE of:
#   1) Self-hosted vLLM/SGLang serving UI-TARS-1.5-7B / UI-TARS-72B-DPO
#   2) Hugging Face Inference Endpoint running a UI-TARS model
#   3) Volcengine Ark (ByteDance) hosted UI-TARS endpoint
UI_TARS_BASE_URL=https://your-model-host/v1
UI_TARS_API_KEY=sk-xxxxxxxxxxxxxxxxxxxx
UI_TARS_MODEL_NAME=ui-tars-1.5-7b

# --- Bridge server ------------------------------------------------------
UI_TARS_BRIDGE_PORT=8642
# Shared secret Hermes must send as "Authorization: Bearer <token>".
# Leave blank only if the bridge is bound to 127.0.0.1 and never exposed.
UI_TARS_BRIDGE_TOKEN=change-me-to-a-random-string

UI_TARS_MAX_LOOP_COUNT=40
