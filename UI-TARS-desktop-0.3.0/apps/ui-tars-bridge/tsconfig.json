{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "outDir": "dist",
    "declaration": true,
    "paths": {
      "@ui-tars/shared": ["../../packages/shared/src/index.ts"],
      "@ui-tars/shared/*": ["../../packages/shared/src/*"]
    }
  },
  "include": ["src"]
}