{
  "name": "@apps/ui-tars-bridge",
  "version": "0.1.0",
  "private": true,
  "description": "HTTP bridge that lets an external agent (Hermes Agent) delegate GUI-control tasks to the UI-TARS SDK + NutJSOperator on this machine.",
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsup src/server.ts --format esm --target node18 --dts",
    "start": "node dist/server.js"
  },
  "dependencies": {
    "@ui-tars/sdk": "workspace:*",
    "@ui-tars/operator-nut-js": "workspace:*",
    "@ui-tars/shared": "workspace:*",
    "express": "^4.19.2",
    "dotenv": "^16.4.5",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/uuid": "^9.0.7",
    "tsup": "^8.0.1",
    "tsx": "^4.7.0",
    "typescript": "^5.4.5"
  }
}